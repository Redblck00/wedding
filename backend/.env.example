# The +psycopg suffix selects the psycopg 3 driver. A bare `postgresql://` URL
# makes SQLAlchemy look for psycopg2, which is not installed in this venv.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wedding_saas

JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloudinary — dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wedding-saas

# Next.js frontend base URL — QR codes and public invitation links point here
PUBLIC_BASE_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000

# Public RSVP throttle. The defaults below are already applied — set these only
# to override. They are sized to stop a script flooding the table, not to ration
# replies per guest: carrier CGNAT and venue wifi put many real guests behind one
# address, so tightening them turns guests away silently. See config.py.
# RSVP_BURST_LIMIT=10          # per address, per invitation, per minute
# RSVP_HOURLY_LIMIT=60         # per address, per invitation, per hour
# RSVP_DUPLICATE_WINDOW_SECONDS=300

# Auth throttle. Login counts failed attempts only; a success clears that email's
# budget. Registration counts every attempt.
# LOGIN_IP_LIMIT=50            # failures per address per 15 min
# LOGIN_EMAIL_LIMIT=10         # failures per email per 15 min
# REGISTER_IP_LIMIT=10         # registrations per address per hour

# MUST be set once a reverse proxy is in front of the app, or every request looks
# like it came from the proxy and the whole site shares one throttle bucket.
# Leave at 0 when uvicorn is exposed directly — X-Forwarded-For is then attacker
# controlled, and trusting it hands out a fresh identity per request.
TRUSTED_PROXY_COUNT=0
