# The +psycopg suffix selects the psycopg 3 driver. A bare `postgresql://` URL
# makes SQLAlchemy look for psycopg2, which is not installed in this venv.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wedding_saas

JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cloudinary — dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wedding-saas

# Next.js frontend base URL — QR codes and public invitation links point here
PUBLIC_BASE_URL=http://localhost:3000

CORS_ORIGINS=http://localhost:3000

# Public RSVP throttle. The defaults below are already applied — set these only
# to override.
#
# These are per INVITATION, not per guest. Replies arrive browser -> Vercel ->
# backend because the submit is a Server Action, so every guest of a wedding
# shares one bucket no matter what TRUSTED_PROXY_COUNT is set to. Sized to stop a
# flooding script while letting a room full of guests reply at once; tightening
# them turns real guests away silently. See config.py.
# RSVP_BURST_LIMIT=40          # per invitation, per minute
# RSVP_HOURLY_LIMIT=300        # per invitation, per hour
# RSVP_DUPLICATE_WINDOW_SECONDS=300

# Auth throttle. Login counts failed attempts only; a success clears that email's
# budget. Registration counts every attempt.
# LOGIN_IP_LIMIT=50            # failures per address per 15 min
# LOGIN_EMAIL_LIMIT=10         # failures per email per 15 min
# REGISTER_IP_LIMIT=10         # registrations per address per hour

# How many reverse proxies sit in front of the app, counted from the right of
# X-Forwarded-For. Leave at 0 when uvicorn is exposed directly — the header is
# then attacker controlled, and trusting it hands out a fresh identity per
# request, which is worse than one shared bucket.
#
# Raising this only helps when the guest's own address actually reaches the
# backend. It does not today: every public request comes through a Next.js
# Server Action, which opens its own connection and forwards no address, so the
# backend sees the frontend's host and nothing else. Set this above 0 only
# together with forwarding the real address from the frontend — and count the
# hops the host's own proxy appends when choosing the number.
TRUSTED_PROXY_COUNT=0
